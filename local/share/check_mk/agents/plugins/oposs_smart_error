#!/usr/bin/env python3
"""
CheckMK Agent Plugin for SMART Error Monitoring
Collects SMART error counter logs from all available drives
This runs on the monitored host, not the CheckMK server
Compatible with CheckMK 2.3
"""

import json
import os
import shutil
import subprocess
from typing import Dict, List, Optional, Tuple

CONFIG_FILE = os.path.join(os.environ.get("MK_CONFDIR", "/etc/check_mk"), "oposs_smart_error.json")

def get_timeout() -> int:
    """Read timeout from config file, return default if not found."""
    if not os.path.exists(CONFIG_FILE):
        return 5
    try:
        with open(CONFIG_FILE, 'r') as f:
            config = json.load(f)
        return max(1, int(config.get("timeout", 5)))
    except (json.JSONDecodeError, IOError, TypeError, ValueError):
        return 5


def get_smart_devices(timeout: int) -> List[Dict]:
    """Get list of SMART-capable devices"""
    try:
        result = subprocess.run(
            ['smartctl', '--json', '--scan'],
            capture_output=True,
            text=True,
            timeout=timeout * 3  # allow extra time for scanning
        )
        if result.returncode != 0:
            return []
        
        data = json.loads(result.stdout)
        return data.get('devices', [])
    except (subprocess.TimeoutExpired, json.JSONDecodeError, FileNotFoundError):
        return []


# smartctl exit status bits after which its JSON holds no device data. The
# other bits (a command failed, drive health, logged errors) come with
# complete JSON.
SMARTCTL_FATAL_BITS = {
    0x01: "command line did not parse",
    0x02: "device open failed",
}


def run_smartctl_json(args: List[str], timeout: int) -> Tuple[Optional[Dict], str]:
    """Run smartctl with JSON output. Return (data, "") or (None, reason)."""
    try:
        result = subprocess.run(
            ['smartctl', *args],
            capture_output=True,
            text=True,
            timeout=timeout
        )
    except subprocess.TimeoutExpired:
        return None, f"no answer within {timeout} s"
    except FileNotFoundError:
        return None, "smartctl not found"
    rc = result.returncode
    if rc < 0:
        return None, f"smartctl killed by signal {-rc}"
    reasons = [text for bit, text in SMARTCTL_FATAL_BITS.items() if rc & bit]
    if reasons:
        return None, f"{', '.join(reasons)} (smartctl exit status {rc})"
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None, f"no JSON output (smartctl exit status {rc})"
    if not isinstance(data, dict):
        return None, f"unexpected JSON output (smartctl exit status {rc})"
    return data, ""


def device_args(device: Dict) -> List[str]:
    """smartctl arguments addressing a scanned device, with the type the scan found"""
    if device.get('type'):
        return ['-d', device['type'], device['name']]
    return [device['name']]


def device_key(device: Dict) -> str:
    """Name a scanned device uniquely.

    Disks behind a RAID controller share one device name and differ only in
    the type (megaraid,0, megaraid,1, ...). Plain devices keep their name.
    """
    if ',' in device.get('type', ''):
        return f"{device['name']} {device['type']}"
    return device['name']


# The background scan log holds up to 2048 medium error entries. A disk that
# is going bad would put hundreds of KB into every agent run; the newest
# entries are the ones that matter.
BMS_MAX_RESULTS = 50


def get_smart_data(device: Dict, timeout: int) -> Tuple[Optional[Dict], str]:
    """Get device info, error counter log and background scan log in one call.

    A drive without a background scan log only sets exit status bit 2, so
    its error counters still arrive.
    """
    return run_smartctl_json(
        ['--json=c', '--info', '--log=error', '--log=background', '--attributes', *device_args(device)],
        timeout)


def trim_background_scan(scan: Dict) -> Dict:
    """Keep the newest BMS_MAX_RESULTS medium error entries and count the rest"""
    results = [k for k, v in scan.items() if k.startswith('result_') and isinstance(v, dict)]
    if len(results) <= BMS_MAX_RESULTS:
        return scan
    results.sort(key=lambda k: (scan[k].get('accumulated_power_on', {}).get('minutes', 0),
                                scan[k].get('parameter_code', 0)))
    dropped = set(results[:-BMS_MAX_RESULTS])
    trimmed = {k: v for k, v in scan.items() if k not in dropped}
    trimmed['results_omitted'] = len(dropped)
    return trimmed


def get_background_data(data: Dict) -> Dict:
    """Background medium scan log, power-on time and grown defect count"""
    background = {}
    if isinstance(data.get('scsi_background_scan'), dict):
        background['background_scan'] = trim_background_scan(data['scsi_background_scan'])
    power_on = data.get('power_on_time')
    if isinstance(power_on, dict) and 'hours' in power_on:
        background['power_on_minutes'] = power_on['hours'] * 60 + power_on.get('minutes', 0)
    if isinstance(data.get('scsi_grown_defect_list'), int):
        background['grown_defects'] = data['scsi_grown_defect_list']
    return background


def get_bms_mode_page(device_name: str, timeout: int) -> Optional[str]:
    """Get the Background Control mode page (0x1c/1) as hex, if sg_modes is installed"""
    if not shutil.which('sg_modes'):
        return None
    try:
        result = subprocess.run(
            ['sg_modes', '-r', '-p', '0x1c,1', device_name],
            capture_output=True,
            timeout=timeout
        )
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None
    if result.returncode != 0 or not result.stdout:
        return None
    return result.stdout.hex()


def main():
    """Main function to collect and output SMART error data"""
    timeout = get_timeout()
    devices = get_smart_devices(timeout)
    
    if not devices:
        # No SMART devices found - don't output section at all
        return

    print("<<<oposs_smart_error:sep(124)>>>")

    # A JBOD disk on a RAID controller is listed twice, as /dev/sdX and as
    # /dev/bus/N with a megaraid,N type. Plain devices go first, and a RAID
    # path whose serial was already reported is skipped.
    devices.sort(key=lambda d: ',' in d.get('type', ''))
    serials_seen = set()

    for device in devices:
        if not device.get('name'):
            continue
        device_name = device_key(device)

        smart_data, reason = get_smart_data(device, timeout)
        if smart_data is None:
            print(f"{device_name}|ERROR|Failed to get SMART data: {reason}")
            continue
        
        # Extract relevant data
        device_info = smart_data.get('device', {})
        # SCSI/SAS drives report model and firmware under their own names
        model_info = smart_data.get('model_name') or smart_data.get('scsi_model_name', '')
        serial_info = smart_data.get('serial_number', '')
        firmware_info = smart_data.get('firmware_version') or smart_data.get('scsi_revision', '')
        capacity_info = smart_data.get('user_capacity', {})
        error_log = smart_data.get('scsi_error_counter_log', {})
        
        # Skip drives without error counter logs (common for SSDs, USB drives, etc.)
        if not error_log:
            continue
        
        # Validate that error counters contain expected operations (read, write, verify)
        valid_operations = ['read', 'write', 'verify']
        if not any(op in error_log for op in valid_operations):
            continue
        
        # Check if at least one operation has meaningful data
        has_meaningful_data = False
        for operation in valid_operations:
            if operation in error_log:
                op_data = error_log[operation]
                if isinstance(op_data, dict) and 'total_errors_corrected' in op_data:
                    has_meaningful_data = True
                    break
        
        if not has_meaningful_data:
            continue
        
        if serial_info and ',' in device.get('type', '') and serial_info in serials_seen:
            continue
        serials_seen.add(serial_info)

        # Create compact JSON output with friendly info
        output_data = {
            'device': device_name,
            'protocol': device_info.get('protocol', 'unknown'),
            'model': model_info,
            'serial': serial_info,
            'firmware': firmware_info,
            'capacity_bytes': capacity_info.get('bytes', 0) if isinstance(capacity_info, dict) else 0,
            'error_counters': error_log
        }

        # Background medium scan (BMS) status and results, SAS drives only
        output_data.update(get_background_data(smart_data))
        # sg_modes cannot reach a disk behind a RAID controller; it would ask the controller
        if 'background_scan' in output_data and device_name == device['name']:
            mode_page = get_bms_mode_page(device['name'], timeout)
            if mode_page:
                output_data['bms_mode_page'] = mode_page
        
        print(f"{device_name}|{json.dumps(output_data, separators=(',', ':'))}")


if __name__ == "__main__":
    main()