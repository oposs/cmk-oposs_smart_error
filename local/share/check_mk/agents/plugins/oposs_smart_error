#!/usr/bin/env python3
"""
CheckMK Agent Plugin for SMART Error Monitoring
Collects SMART error counter logs from all available drives
This runs on the monitored host, not the CheckMK server
Compatible with CheckMK 2.3
"""

import json
import os
import shutil
import subprocess
from typing import Dict, List, Optional, Tuple

CONFIG_FILE = os.path.join(os.environ.get("MK_CONFDIR", "/etc/check_mk"), "oposs_smart_error.json")
# Skip counts and the identity of each disk, for disks that sleep
STATE_FILE = os.path.join(os.environ.get("MK_VARDIR", "/var/lib/check_mk_agent"), "oposs_smart_error.state.json")

# standby: "skip" leaves disks in STANDBY or SLEEP alone, "wake" reads them anyway.
# wake_after: read a sleeping disk after this many skips in a row, 0 never.
DEFAULT_CONFIG = {"timeout": 5, "standby": "skip", "wake_after": 0}


def get_config() -> Dict:
    """Read the baked settings; a missing file or value keeps the default."""
    config = dict(DEFAULT_CONFIG)
    try:
        with open(CONFIG_FILE, 'r') as f:
            baked = json.load(f)
        if isinstance(baked, dict):
            config.update(baked)
    except (json.JSONDecodeError, OSError):
        pass
    for key, minimum in (("timeout", 1), ("wake_after", 0)):
        try:
            config[key] = max(minimum, int(config[key]))
        except (TypeError, ValueError):
            config[key] = DEFAULT_CONFIG[key]
    if config["standby"] not in ("skip", "wake"):
        config["standby"] = DEFAULT_CONFIG["standby"]
    return config


def get_timeout() -> int:
    """Timeout for each smartctl call in seconds"""
    return get_config()["timeout"]


def load_state() -> Dict:
    try:
        with open(STATE_FILE, 'r') as f:
            state = json.load(f)
    except (json.JSONDecodeError, OSError):
        return {}
    return state if isinstance(state, dict) else {}


def save_state(state: Dict) -> None:
    try:
        with open(STATE_FILE + '.new', 'w') as f:
            json.dump(state, f)
        os.replace(STATE_FILE + '.new', STATE_FILE)
    except OSError:
        pass


def get_smart_devices(timeout: int) -> List[Dict]:
    """Get list of SMART-capable devices"""
    try:
        result = subprocess.run(
            ['smartctl', '--json', '--scan'],
            capture_output=True,
            text=True,
            timeout=timeout * 3  # allow extra time for scanning
        )
        if result.returncode != 0:
            return []
        
        data = json.loads(result.stdout)
        return data.get('devices', [])
    except (subprocess.TimeoutExpired, json.JSONDecodeError, FileNotFoundError):
        return []


# smartctl exit status bits after which its JSON holds no device data. The
# other bits (a command failed, drive health, logged errors) come with
# complete JSON.
SMARTCTL_FATAL_BITS = {
    0x01: "command line did not parse",
    0x02: "device open failed",
}

# Exit status asked of smartctl -n for a disk it left asleep. smartctl never
# sets bits 0 and 1 together itself: after bit 0 it opens no device.
SMARTCTL_ASLEEP = 3
ASLEEP = "asleep"


def smartctl_message(args: List[str], timeout: int) -> str:
    """Run smartctl as text and return why it gave up.

    In JSON mode smartctl 7.4 keeps this message to itself. It follows the
    "Local Time is:" line, or the copyright header when the device did not
    open at all.
    """
    try:
        result = subprocess.run(
            ['smartctl', *args],
            capture_output=True,
            text=True,
            timeout=timeout
        )
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return ""
    lines = result.stdout.splitlines()
    for index, line in enumerate(lines):
        if line.startswith('Local Time is:'):
            lines = lines[index + 1:]
            break
    else:
        lines = [line for line in lines if not line.startswith(('smartctl ', 'Copyright (C)'))]
    message = [
        ' '.join(line.split()) for line in lines
        if line.strip()
        and not line.startswith('===')
        and not line.startswith('A mandatory SMART command failed')
    ]
    return '; '.join(message)


def run_smartctl_json(args: List[str], timeout: int) -> Tuple[Optional[Dict], str]:
    """Run smartctl with JSON output. Return (data, "") or (data, reason).

    On failure data is None, except when smartctl gave up but still named the
    drive in its JSON; then data holds that partial answer.
    """
    try:
        result = subprocess.run(
            ['smartctl', *args],
            capture_output=True,
            text=True,
            timeout=timeout
        )
    except subprocess.TimeoutExpired:
        return None, f"no answer within {timeout} s"
    except FileNotFoundError:
        return None, "smartctl not found"
    rc = result.returncode
    if rc < 0:
        return None, f"smartctl killed by signal {-rc}"
    if rc == SMARTCTL_ASLEEP and '-n' in args:
        return None, ASLEEP
    reasons = [text for bit, text in SMARTCTL_FATAL_BITS.items() if rc & bit]
    try:
        data = json.loads(result.stdout)
        problem = "" if isinstance(data, dict) else "unexpected JSON output"
    except json.JSONDecodeError:
        problem = "no JSON output"
    if problem:
        data = None
    if reasons:
        message = smartctl_message([arg for arg in args if not arg.startswith('--json')], timeout)
        return data, f"{message or ', '.join(reasons)} (smartctl exit status {rc})"
    if problem:
        return None, f"{problem} (smartctl exit status {rc})"
    return data, ""


def device_args(device: Dict) -> List[str]:
    """smartctl arguments addressing a scanned device, with the type the scan found"""
    if device.get('type'):
        return ['-d', device['type'], device['name']]
    return [device['name']]


def device_key(device: Dict) -> str:
    """Name a scanned device uniquely.

    Disks behind a RAID controller share one device name and differ only in
    the type (megaraid,0, megaraid,1, ...). Plain devices keep their name.
    """
    if ',' in device.get('type', ''):
        return f"{device['name']} {device['type']}"
    return device['name']


# The background scan log holds up to 2048 medium error entries. A disk that
# is going bad would put hundreds of KB into every agent run; the newest
# entries are the ones that matter.
BMS_MAX_RESULTS = 50


def get_smart_data(device: Dict, timeout: int, skip_asleep: bool) -> Tuple[Optional[Dict], str]:
    """Get device info, error counter log and background scan log in one call.

    A drive without a background scan log only sets exit status bit 2, so
    its error counters still arrive. With skip_asleep, a disk in STANDBY or
    SLEEP is left alone and the reason is ASLEEP.
    """
    nocheck = ['-n', f'standby,{SMARTCTL_ASLEEP}'] if skip_asleep else []
    return run_smartctl_json(
        ['--json=c', *nocheck, '--info', '--log=error', '--log=background', '--attributes',
         *device_args(device)],
        timeout)


def trim_background_scan(scan: Dict) -> Dict:
    """Keep the newest BMS_MAX_RESULTS medium error entries and count the rest"""
    results = [k for k, v in scan.items() if k.startswith('result_') and isinstance(v, dict)]
    if len(results) <= BMS_MAX_RESULTS:
        return scan
    results.sort(key=lambda k: (scan[k].get('accumulated_power_on', {}).get('minutes', 0),
                                scan[k].get('parameter_code', 0)))
    dropped = set(results[:-BMS_MAX_RESULTS])
    trimmed = {k: v for k, v in scan.items() if k not in dropped}
    trimmed['results_omitted'] = len(dropped)
    return trimmed


def get_background_data(data: Dict) -> Dict:
    """Background medium scan log, power-on time and grown defect count"""
    background = {}
    if isinstance(data.get('scsi_background_scan'), dict):
        background['background_scan'] = trim_background_scan(data['scsi_background_scan'])
    power_on = data.get('power_on_time')
    if isinstance(power_on, dict) and 'hours' in power_on:
        background['power_on_minutes'] = power_on['hours'] * 60 + power_on.get('minutes', 0)
    if isinstance(data.get('scsi_grown_defect_list'), int):
        background['grown_defects'] = data['scsi_grown_defect_list']
    return background


def get_bms_mode_page(device_name: str, timeout: int) -> Optional[str]:
    """Get the Background Control mode page (0x1c/1) as hex, if sg_modes is installed"""
    if not shutil.which('sg_modes'):
        return None
    try:
        result = subprocess.run(
            ['sg_modes', '-r', '-p', '0x1c,1', device_name],
            capture_output=True,
            timeout=timeout
        )
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None
    if result.returncode != 0 or not result.stdout:
        return None
    return result.stdout.hex()


def drive_identity(data: Dict) -> Optional[Dict]:
    """Model, serial and transport of a drive that answered but gave no data.

    The check uses them to give such a drive a service; without a serial
    number there is nothing to name it by.
    """
    if not data.get('serial_number'):
        return None
    return {
        'model': data.get('model_name') or data.get('scsi_model_name', ''),
        'serial': data['serial_number'],
        'firmware': data.get('firmware_version') or data.get('scsi_revision', ''),
        'protocol': data.get('device', {}).get('protocol', ''),
        'transport': data.get('scsi_transport_protocol', {}).get('name', ''),
    }


def standby_line(device_name: str, skips: int, identity: Optional[Dict]) -> str:
    """Line for a disk left asleep, with what its last read reported.

    The identity lets the check keep the services of the disk.
    """
    data = {'skips': skips, **(identity or {})}
    return f"{device_name}|STANDBY|{json.dumps(data, separators=(',', ':'))}"


def main():
    """Main function to collect and output SMART error data"""
    config = get_config()
    timeout = config['timeout']
    devices = get_smart_devices(timeout)

    if not devices:
        # No SMART devices found - don't output section at all
        return

    print("<<<oposs_smart_error:sep(124)>>>")

    old_state = load_state()
    state = {}

    # A JBOD disk on a RAID controller is listed twice, as /dev/sdX and as
    # /dev/bus/N with a megaraid,N type. Plain devices go first, and a RAID
    # path whose serial was already reported is skipped.
    devices.sort(key=lambda d: ',' in d.get('type', ''))
    serials_seen = set()

    for device in devices:
        if not device.get('name'):
            continue
        device_name = device_key(device)

        known = old_state.get(device_name)
        known = known if isinstance(known, dict) else {}
        skips = known.get('skips', 0) if isinstance(known.get('skips'), int) else 0
        identity = known.get('identity') if isinstance(known.get('identity'), dict) else None
        skip_asleep = config['standby'] == 'skip' and not (
            config['wake_after'] and skips >= config['wake_after'])

        smart_data, reason = get_smart_data(device, timeout, skip_asleep)
        if reason == ASLEEP:
            state[device_name] = {'skips': skips + 1, 'identity': identity}
            # A RAID path never read on its own is most likely a disk already
            # listed under its plain name, and nothing can tell them apart
            if ',' in device.get('type', '') and (identity is None or identity.get('serial') in serials_seen):
                continue
            if identity and identity.get('serial'):
                serials_seen.add(identity['serial'])
            print(standby_line(device_name, skips + 1, identity))
            continue
        if reason:
            if known:
                state[device_name] = known
            # '|' separates the fields of the line
            line = f"{device_name}|ERROR|Failed to get SMART data: {reason.replace('|', '/')}"
            identity = drive_identity(smart_data or {})
            if identity:
                line += f"|{json.dumps(identity, separators=(',', ':'))}"
            print(line)
            continue
        
        # Extract relevant data
        device_info = smart_data.get('device', {})
        # SCSI/SAS drives report model and firmware under their own names
        model_info = smart_data.get('model_name') or smart_data.get('scsi_model_name', '')
        serial_info = smart_data.get('serial_number', '')
        firmware_info = smart_data.get('firmware_version') or smart_data.get('scsi_revision', '')
        capacity_info = smart_data.get('user_capacity', {})
        error_log = smart_data.get('scsi_error_counter_log', {})
        
        # Skip drives without error counter logs (common for SSDs, USB drives, etc.)
        if not error_log:
            continue
        
        # Validate that error counters contain expected operations (read, write, verify)
        valid_operations = ['read', 'write', 'verify']
        if not any(op in error_log for op in valid_operations):
            continue
        
        # Check if at least one operation has meaningful data
        has_meaningful_data = False
        for operation in valid_operations:
            if operation in error_log:
                op_data = error_log[operation]
                if isinstance(op_data, dict) and 'total_errors_corrected' in op_data:
                    has_meaningful_data = True
                    break
        
        if not has_meaningful_data:
            continue
        
        if serial_info and ',' in device.get('type', '') and serial_info in serials_seen:
            continue
        serials_seen.add(serial_info)

        # Create compact JSON output with friendly info
        output_data = {
            'device': device_name,
            'protocol': device_info.get('protocol', 'unknown'),
            'model': model_info,
            'serial': serial_info,
            'firmware': firmware_info,
            'capacity_bytes': capacity_info.get('bytes', 0) if isinstance(capacity_info, dict) else 0,
            'error_counters': error_log
        }

        # Background medium scan (BMS) status and results, SAS drives only
        output_data.update(get_background_data(smart_data))
        # sg_modes cannot reach a disk behind a RAID controller; it would ask the controller
        if 'background_scan' in output_data and device_name == device['name']:
            mode_page = get_bms_mode_page(device['name'], timeout)
            if mode_page:
                output_data['bms_mode_page'] = mode_page

        state[device_name] = {'skips': 0, 'identity': {
            'serial': serial_info,
            'model': model_info,
            'firmware': firmware_info,
            'capacity_bytes': output_data['capacity_bytes'],
            'background_scan': 'background_scan' in output_data,
        }}

        print(f"{device_name}|{json.dumps(output_data, separators=(',', ':'))}")

    if state != old_state:
        save_state(state)


if __name__ == "__main__":
    main()